            <div id="receipt-content" style="padding: 15px; color: #000; font-size: 0.9rem; line-height: 1.5; background: #fff;">
                <div style="text-align: center; margin-bottom: 12px;">
                    <h2 style="margin: 0; font-size: 1.3rem; font-weight: bold;">RxPOS PHARMACY</h2>
                    <p style="margin: 2px 0; font-size: 0.8rem;">123 Health St., Biñan Laguna</p>
                    <p style="margin: 2px 0; font-size: 0.8rem;">VAT Reg. TIN: 000-123-456-000</p>
                    <p style="margin: 2px 0; font-size: 0.8rem;">SN: POS-9988-PH</p>
                </div>
                <div style="border-bottom: 1px dashed #000; margin-bottom: 10px; padding-bottom: 8px;">
                    <div style="display: flex; justify-content: space-between;"><span style="font-weight: bold;">Date:</span> <span id="rec-date"></span></div>
                    <div style="display: flex; justify-content: space-between;"><span style="font-weight: bold;">Receipt No:</span> <span>#<span id="rec-id"></span></span></div>
                    <div style="display: flex; justify-content: space-between;"><span style="font-weight: bold;">Cashier:</span> <span id="rec-cashier"></span></div>
                </div>
