                            <form action="/admin/branding" method="POST">
                                <input type="text" name="app_name" class="form-control" placeholder="App Name" value="<%= settings.app_name || '' %>" required>
                                <input type="url" name="app_logo_url" class="form-control" placeholder="Logo Image URL" value="<%= settings.app_logo_url || '' %>">
                                <div style="display:flex; gap:12px; align-items:center; margin-bottom:16px;">
                                    <% if (settings.app_logo_url) { %>
                                        <div style="width:80px; height:80px; border:1px solid #cbd5e1; border-radius:12px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#fff;">
                                            <img src="<%= settings.app_logo_url %>" alt="Logo preview" style="max-width:100%; max-height:100%; object-fit:contain;" />
                                        </div>
                                    <% } %>
                                    <div style="color:#475569; font-size:0.95rem;">
                                        I-paste ang logo URL para lumabas sa tuktok na header.
                                    </div>
                                </div>
                                <button type="submit" class="btn" style="background: #2563eb; width: 100%;">Save Branding</button>
                            </form>
                        </div>
                        <div id="admin-tab-users" class="admin-tab-panel" role="tabpanel">
