                                    <label style="display:flex; gap: 8px; align-items:center;"><input type="checkbox" name="allowed_pages" value="inventory"> Imbentaryo</label>
                                    <label style="display:flex; gap: 8px; align-items:center;"><input type="checkbox" name="allowed_pages" value="prescriptions"> Reseta</label>
                                    <label style="display:flex; gap: 8px; align-items:center;"><input type="checkbox" name="allowed_pages" value="sales"> Sales History</label>
                                    <label style="display:flex; gap: 8px; align-items:center;"><input type="checkbox" name="allowed_pages" value="admin"> Admin Branding</label>
                                    <label style="display:flex; gap: 8px; align-items:center;"><input type="checkbox" name="allowed_pages" value="users"> User Management</label>
                                </div>
                                <button type="submit" class="btn" style="background: #16a34a; width: 100%;">Create User</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

