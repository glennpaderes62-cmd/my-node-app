                                <thead>
                                    <tr><th>Kategorya</th><th>Bilang</th></tr>
                                </thead>
                                <tbody>
                                    <% Object.keys(inventorySummary.categoryCounts).forEach(category => { %>
                                        <tr>
                                            <td><%= category %></td>
                                            <td><%= inventorySummary.categoryCounts[category] %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
