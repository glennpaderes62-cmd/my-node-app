<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POS System</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Poppins', sans-serif; 
            display: flex; 
            margin: 0; 
            padding: 30px; 
            gap: 30px; 
            background-color: #f0f2f5; 
            color: #2c3e50;
        }
        .products { 
            flex: 2; 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
            gap: 20px; 
        }
        .product-card { 
            background: #ffffff; 
            padding: 20px; 
            text-align: center; 
            cursor: pointer; 
            border-radius: 12px; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.05); 
            transition: transform 0.2s, box-shadow 0.2s; 
            border: 1px solid #e1e8ed;
        }
        .product-card:hover { 
            transform: translateY(-3px); 
            box-shadow: 0 8px 15px rgba(0,0,0,0.1); 
            border-color: #3498db;
        }
        .product-card h3 { margin: 10px 0 5px; font-size: 1.1rem; }
        .product-card p { color: #27ae60; font-weight: 600; font-size: 1rem; margin: 5px 0; }
        .product-card small { color: #7f8c8d; background: #ecf0f1; padding: 2px 8px; border-radius: 10px; font-size: 0.75rem;}
        
        .cart { 
            flex: 1; 
            background: #ffffff; 
            padding: 25px; 
            border-radius: 12px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.05); 
            height: fit-content; 
        }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { border-bottom: 1px solid #eee; padding: 10px 5px; text-align: left; font-size: 0.9rem; }
        th { color: #7f8c8d; font-weight: 600; text-transform: uppercase; font-size: 0.8rem; }
        
        .checkout-btn { 
            width: 100%; 
            padding: 12px; 
            background: #27ae60; 
            color: white; 
            border: none; 
            border-radius: 8px; 
            font-size: 16px; 
            font-weight: 600;
            cursor: pointer; 
            transition: background 0.2s; 
        }
        .checkout-btn:hover { background: #219653; }
        
        .login-container { width: 100%; max-width: 380px; margin: 80px auto; background: #fff; padding: 35px; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.08); text-align: center; }
        .login-container input { width: 100%; box-sizing: border-box; padding: 12px; margin-bottom: 15px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; }
        .login-container button { width: 100%; padding: 12px; background: #3498db; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; }
        .login-container button:hover { background: #2980b9; }
        .logout-link { color: #e74c3c; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
        .logout-link:hover { text-decoration: underline; }
    </style>
</head>
<body>

    <% if (!user) { %>
        <!-- Login Screen -->
        <div class="login-container">
            <h2>POS Login</h2>
            <% if (typeof error !== 'undefined' && error) { %>
                <p style="color: #e74c3c; font-size: 0.85rem; margin-bottom: 15px;"><%= error %></p>
            <% } %>
            <form action="/login" method="POST">
                <input type="text" name="username" placeholder="Username (admin)" required>
                <input type="password" name="password" placeholder="Password (12345)" required>
                <button type="submit">Log In</button>
            </form>
        </div>
    <% } else { %>
        <!-- POS Dashboard Screen -->
        <div class="products">
            <div style="grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                <h2>Welcome, <%= user %></h2>
                <a href="/logout" class="logout-link">Log Out</a>
            </div>
            
            <% if (products && products.length > 0) { %>
                <% products.forEach(p => { %>
                    <div class="product-card" onclick="addToCart('<%= p.id %>', '<%= p.name %>', <%= p.price %>)">
                        <h3><%= p.name %></h3>
                        <p>₱<%= p.price.toFixed(2) %></p>
                        <small>Stock: <%= p.stock %></small>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="grid-column: 1 / -1; color: #7f8c8d;">Walang mahanap na produkto.</p>
            <% } %>
        </div>

        <div class="cart">
            <h2>Current Cart</h2>
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody id="cart-items">
                </tbody>
            </table>
            <h3 style="display: flex; justify-content: space-between; margin: 15px 0; font-size: 1.1rem;">
                <span>Total:</span> 
                <span style="color: #27ae60;">₱<span id="cart-total">0.00</span></span>
            </h3>
            <button class="checkout-btn" onclick="checkout()">Checkout</button>
        </div>

        <script>
            let cart = [];

            function addToCart(id, name, price) {
                let item = cart.find(i => i.id === id);
                if (item) {
                    item.qty++;
                } else {
                    cart.push({ id, name, price, qty: 1 });
                }
                updateCartUI();
            }

            function updateCartUI() {
                let tbody = document.getElementById('cart-items');
                let totalSpan = document.getElementById('cart-total');
                tbody.innerHTML = '';
                let total = 0;

                cart.forEach(item => {
                    let subtotal = item.price * item.qty;
                    total += subtotal;
                    tbody.innerHTML += `<tr><td>${item.name}</td><td>${item.qty}</td><td>₱${subtotal.toFixed(2)}</td></tr>`;
                });

                totalSpan.innerText = total.toFixed(2);
            }

            function checkout() {
                if (cart.length === 0) {
                    alert('Walang laman ang cart!');
                    return;
                }

                let total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

                fetch('/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ total })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('Tagumpay ang transaksyon! Sale ID: ' + data.saleId);
                        cart = [];
                        updateCartUI();
                    } else {
                        alert('May error sa pag-checkout.');
                    }
                })
                .catch(err => {
                    console.error('Checkout error:', err);
                    alert('Hindi maka-connect sa server.');
                });
            }
        </script>
    <% } %>

</body>
</html>