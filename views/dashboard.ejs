                                    <th>ID</th>
                                    <th>Pangalan</th>
                                    <th>Kategorya</th>
                                    <th>Stock</th>
                                    <th>Presyo</th>
                                    <th>Expiry</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% products.forEach(product => { %>
                                    <tr style="<%= product.stock <= inventorySummary.lowStockThreshold ? 'background: #fff1f0;' : '' %>">
                                        <td>#<%= product.id %></td>
                                        <td><%= product.name %></td>
                                        <td><%= product.category %></td>
                                        <td><%= product.stock %></td>
                                        <td>₱<%= Number(product.price).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></td>
                                        <td><%= product.expiry_date %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
                    </div>
            <% } %>
            <% if (activeAllowedPages.includes('admin')) { %>
            <div id="pane-admin" class="module-pane <%= firstAllowedPage === 'admin' ? 'active' : '' %>">
                <div class="module-content">
                    <div class="admin-dashboard">
                        <h2 class="admin-dashboard-title">Admin Dashboard</h2>
                        <p class="admin-dashboard-subtitle">Pamahalaan ang branding at user accounts ng system.</p>
                        <div class="admin-tabs" role="tablist" aria-label="Admin dashboard sections">
                            <button type="button" class="admin-tab active" role="tab" aria-selected="true" onclick="switchAdminTab('branding', this)">Branding</button>
                            <button type="button" class="admin-tab" role="tab" aria-selected="false" onclick="switchAdminTab('users', this)">Create User</button>
                        </div>
