<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RxPOS - Pharmacy Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; margin: 0; padding: 20px; background-color: #f4f7f6; color: #333; }
        header { display: flex; justify-content: space-between; align-items: center; background: #0e6251; color: white; padding: 15px 25px; border-radius: 10px; margin-bottom: 20px; }
        .grid-container { display: grid; grid-template-columns: 2fr 1.2fr; gap: 20px; }
        .card { background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.04); margin-bottom: 20px; border: 1px solid #e2e8f0; }
        
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; max-height: 350px; overflow-y: auto; margin-top: 10px; }
        .product-card { background: #fdfefe; border: 1px solid #cbd5e1; padding: 12px; border-radius: 8px; text-align: center; cursor: pointer; transition: 0.2s; }
        .product-card:hover { border-color: #1abc9c; background: #e8f8f5; transform: translateY(-2px); }
        .product-card h4 { margin: 5px 0; font-size: 0.95rem; }
        .product-card p { color: #27ae60; font-weight: 600; margin: 5px 0; font-size: 0.9rem; }
        .badge-rx { background: #e74c3c; color: white; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; display: inline-block; margin-top: 4px; }
        .badge-otc { background: #3498db; color: white; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; display: inline-block; margin-top: 4px; }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.85rem; }
        th, td { border-bottom: 1px solid #edf2f7; padding: 8px; text-align: left; }
        th { color: #718096; text-transform: uppercase; font-size: 0.75rem; }

        .btn { width: 100%; padding: 10px; background: #27ae60; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; }
        .btn:hover { background: #219653; }
        .form-control { width: 100%; padding: 8px; margin-bottom: 10px; border: 1px solid #cbd5e1; border-radius: 6px; box-sizing: border-box; font-size: 0.85rem; }
        .logout { color: #f1c40f; text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>

    <header>
        <h2>💊 RxPOS Pharmacy System</h2>
        <div>
            <span>Pharmacist: <strong><%= user %></strong> | </span>
            <a href="/logout" class="logout">Log Out</a>
        </div>
    </header>

    <div class="grid-container">
        <!-- Left Panel: Products & Sales History -->
        <div>
            <div class="card">
                <h3>Katalogo ng mga Gamot</h3>
                <div class="products-grid">
                    <% products.forEach(p => { %>
                        <div class="product-card" onclick="addToCart('<%= p.id %>', '<%= p.name %>', <%= p.price %>, <%= p.stock %>, '<%= p.requires_prescription %>')">
                            <h4><%= p.name %></h4>
                            <p>₱<%= p.price.toFixed(2) %></p>
                            <small>Stock: <%= p.stock %></small><br>
                            <% if(p.requires_prescription) { %>
                                <span class="badge-rx">Prescription</span>
                            <% } else { %>
                                <span class="badge-otc">OTC</span>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="card">
                <h3>Sales History & Logs</h3>
                <div style="max-height: 180px; overflow-y: auto;">
                    <table>
                        <thead>
                            <tr><th>ID</th><th>Total</th><th>Cashier</th><th>Date</th></tr>
                        </thead>
                        <tbody>
                            <% sales.forEach(s => { %>
                                <tr>
                                    <td>#<%= s.id %></td>
                                    <td style="color: #27ae60; font-weight: bold;">₱<%= s.total.toFixed(2) %></td>
                                    <td><%= s.cashier %></td>
                                    <td><%= s.date %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Panel: Cart, Inventory Management, & Prescription Validation -->
        <div>
            <!-- Cart Module -->
            <div class="card">
                <h3>Current Cart</h3>
                <table>
                    <thead><tr><th>Gamot</th><th>Qty</th><th>Subtotal</th></tr></thead>
                    <tbody id="cart-items"></tbody>
                </table>
                <h3 style="display: flex; justify-content: space-between; margin: 15px 0;">
                    <span>Total:</span> <span style="color: #27ae60;">₱<span id="cart-total">0.00</span></span>
                </h3>
                <button class="btn" onclick="checkout()">I-process ang Bayad</button>
            </div>

            <!-- Prescription Validation Module -->
            <div class="card">
                <h3>I-validate ang Prescription (Rx)</h3>
                <form action="/add-prescription" method="POST">
                    <input type="text" name="patient_name" class="form-control" placeholder="Pangalan ng Pasyente" required>
                    <input type="text" name="doctor_name" class="form-control" placeholder="Pangalan ng Doktor" required>
                    <input type="text" name="medicine_name" class="form-control" placeholder="Resetang Gamot" required>
                    <button type="submit" class="btn" style="background: #2980b9;">I-save ang Reseta</button>
                </form>
            </div>

            <!-- Add Product & Batch/Expiry Inventory Module -->
            <div class="card">
                <h3>Magdagdag ng Gamot / Batch</h3>
                <form action="/add-product" method="POST">
                    <input type="text" name="name" class="form-control" placeholder="Pangalan ng Gamot" required>
                    <input type="text" name="category" class="form-control" placeholder="Kategorya (OTC / Prescription)" required>
                    <input type="number" step="0.01" name="price" class="form-control" placeholder="Presyo (₱)" required>
                    <input type="number" name="stock" class="form-control" placeholder="Dami ng Stock" required>
                    <input type="text" name="batch_no" class="form-control" placeholder="Batch / Lot Number" required>
                    <input type="date" name="expiry_date" class="form-control" required>
                    <label style="font-size: 0.85rem;"><input type="checkbox" name="requires_prescription" value="1"> Kailangan ng Reseta (Rx)?</label>
                    <button type="submit" class="btn" style="background: #8e44ad; margin-top: 10px;">I-save sa Imbentaryo</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        let cart = [];

        function addToCart(id, name, price, stock, requiresRx) {
            if (requiresRx === '1') {
                let hasRx = confirm(`Ang "${name}" ay nangangailangan ng Prescription (Rx). May dala ba silang reseta ng doktor?`);
                if (!hasRx) {
                    alert('Hindi maidadagdag sa cart hangga’t walang beripikadong reseta.');
                    return;
                }
            }

            let item = cart.find(i => i.id === id);
            let currentQty = item ? item.qty : 0;
            if (currentQty + 1 > stock) {
                alert('Kulang ang stock ng gamot na ito!');
                return;
            }

            if (item) {
                item.qty++;
            } else {
                cart.push({ id, name, price, qty: 1 });
            }
            updateCartUI();
        }

        function updateCartUI() {
            let tbody = document.getElementById('cart-items');
            let totalSpan = document.getElementById('cart-total');
            tbody.innerHTML = '';
            let total = 0;

            cart.forEach(item => {
                let subtotal = item.price * item.qty;
                total += subtotal;
                tbody.innerHTML += `<tr><td>${item.name}</td><td>${item.qty}</td><td>₱${subtotal.toFixed(2)}</td></tr>`;
            });

            totalSpan.innerText = total.toFixed(2);
        }

        function checkout() {
            if (cart.length === 0) {
                alert('Walang laman ang cart!');
                return;
            }

            let total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            fetch('/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cart, total })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('Tagumpay ang transaksyon! Sale ID: ' + data.saleId);
                    location.reload();
                } else {
                    alert('May error: ' + data.message);
                }
            });
        }
    </script>
</body>
</html>