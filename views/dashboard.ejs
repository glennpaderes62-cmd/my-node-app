<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.app_name || 'RxPOS' %> - Enterprise Pharmacy System</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; margin: 0; padding: 0; background-color: #f1f5f9; color: #1e293b; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        
        .pos-header { background: #2c3e50; color: white; display: flex; justify-content: space-between; align-items: center; padding: 10px 20px; height: 50px; flex-shrink: 0; }
        .pos-header h2 { margin: 0; font-size: 1.1rem; display: flex; align-items: center; gap: 10px; }
        .pos-header .user-info { font-size: 0.9rem; display: flex; gap: 15px; align-items: center; }
        .pos-header .clock { font-size: 0.9rem; color: #e6eef6; margin-right: 12px; }
        .pos-header a { color: #e74c3c; text-decoration: none; font-weight: 600; }

        .app-layout { display: flex; flex: 1; height: calc(100vh - 50px); overflow: hidden; }
        .sidebar { width: 220px; background: #1e293b; color: #94a3b8; display: flex; flex-direction: column; border-right: 1px solid #334155; }
        .sidebar-title { padding: 15px 20px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #64748b; font-weight: 400; }
        .menu-item { padding: 12px 20px; color: #cbd5e1; text-decoration: none; font-size: 0.9rem; font-weight: 400; display: flex; align-items: center; gap: 12px; cursor: pointer; transition: 0.2s; border-left: 4px solid transparent; }
        .menu-item:hover { background: #334155; color: #fff; }
        .menu-item.active { background: #334155; color: #38bdf8; border-left-color: #38bdf8; font-weight: 500; }

        .content-area { flex: 1; display: flex; overflow: hidden; position: relative; }
        .module-pane { display: none; width: 100%; height: 100%; overflow: hidden; }
        .module-pane.active { display: flex; }

        .pos-main-container { display: flex; width: 100%; height: 100%; }
        .left-panel { width: 42%; background: #ffffff; border-right: 1px solid #cbd5e1; display: flex; flex-direction: column; justify-content: space-between; }
        .cart-section { flex: 1; overflow-y: auto; padding: 15px; }
        .cart-table { width: 100%; border-collapse: collapse; }
        .cart-table th, .cart-table td { padding: 8px; text-align: left; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; cursor: pointer; }
        .cart-table th { color: #64748b; font-size: 0.8rem; text-transform: uppercase; }
        .cart-table tr.selected { background-color: #e0f2fe; }

        .cart-summary { background: #f8fafc; padding: 15px; border-top: 1px solid #e2e8f0; }
        .summary-row { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 1rem; }
        .summary-row.total { font-size: 1.3rem; font-weight: bold; color: #0f172a; }

        .keypad-container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; padding: 10px; background: #e2e8f0; border-top: 1px solid #cbd5e1; }
        .key-btn { background: #ffffff; border: 1px solid #cbd5e1; padding: 12px; font-size: 1.1rem; font-weight: 500; border-radius: 6px; cursor: pointer; text-align: center; }
        .key-btn:active { background: #cbd5e1; }
        .key-btn.action { background: #3b82f6; color: white; border: none; }
        .key-btn.action.active-mode { background: #1d4ed8; outline: 2px solid #93c5fd; }
        .key-btn.payment { background: #10b981; color: white; border: none; grid-column: span 4; font-size: 1.2rem; padding: 14px; font-weight: 600; }

        .right-panel { width: 58%; display: flex; flex-direction: column; background: #f8fafc; overflow: hidden; }
        .categories-bar { display: flex; gap: 10px; padding: 15px; background: #ffffff; border-bottom: 1px solid #e2e8f0; overflow-x: auto; flex-shrink: 0; }
        .cat-btn { background: #e2e8f0; border: none; padding: 8px 16px; border-radius: 20px; font-weight: 400; cursor: pointer; font-size: 0.85rem; white-space: nowrap; }
        .cat-btn.active, .cat-btn:hover { background: #8b5cf6; color: white; }

        .products-grid-container { flex: 1; padding: 15px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; align-content: start; }
        .product-tile { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px; text-align: center; cursor: pointer; transition: 0.2s; display: flex; flex-direction: column; justify-content: space-between; height: 110px; }
        .product-tile:hover { border-color: #8b5cf6; transform: translateY(-2px); box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .product-tile h4 { margin: 0; font-size: 0.9rem; color: #1e293b; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-weight: 400; }
        .product-tile .price { color: #10b981; font-weight: 600; font-size: 0.95rem; margin: 5px 0; }
        .product-tile .stock { font-size: 0.75rem; color: #64748b; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; align-self: center; }
        .product-tile.out-of-stock { border-color: #ef4444; color: #b91c1c; opacity: 0.95; }
        .product-tile.out-of-stock .price { color: #b91c1c; }
        .product-tile.out-of-stock .stock { background: #fee2e2; color: #7f1d1d; }

        .module-content { padding: 25px; width: 100%; overflow-y: auto; background: #f8fafc; }
        .card { background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.04); margin-bottom: 20px; border: 1px solid #e2e8f0; }
        .card h3 { margin-top: 0; color: #1e293b; font-weight: 500; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9rem; }
        th, td { border-bottom: 1px solid #edf2f7; padding: 10px; text-align: left; }
        th { color: #718096; text-transform: uppercase; font-size: 0.75rem; font-weight: 500; }
        .form-control { width: 100%; padding: 10px; margin-bottom: 12px; border: 1px solid #cbd5e1; border-radius: 6px; box-sizing: border-box; font-size: 0.9rem; }
        .btn { padding: 10px 15px; background: #27ae60; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer; }

        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
        .modal-card { background: white; padding: 25px; border-radius: 12px; width: 420px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
        .modal-card h3 { margin-top: 0; color: #0f172a; margin-bottom: 15px; }
        .modal-row { margin-bottom: 12px; }
        .modal-row label { display: block; font-size: 0.85rem; color: #64748b; margin-bottom: 5px; }
        .modal-row input { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 1rem; box-sizing: border-box; }
        
        .payment-methods-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
        .pay-card { background: #f8fafc; border: 2px solid #cbd5e1; border-radius: 8px; padding: 12px; text-align: center; cursor: pointer; font-weight: 600; font-size: 0.95rem; color: #475569; transition: 0.2s; }
        .pay-card:hover { border-color: #3b82f6; }
        .pay-card.active { background: #eff6ff; border-color: #2563eb; color: #1d4ed8; }

        .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
        .modal-actions button { flex: 1; padding: 12px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; }
        .btn-cancel { background: #e2e8f0; color: #475569; }
        .btn-confirm { background: #10b981; color: white; }

        

        /* Clickable Sales History Rows */
        .sales-row { cursor: pointer; transition: background 0.15s; }
        .sales-row:hover { background-color: #f1f5f9; }

        .eod-page { max-width: 980px; margin: 0 auto; }
        .eod-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; margin-bottom: 20px; }
        .eod-field { display: flex; flex-direction: column; gap: 5px; min-width: 160px; }
        .eod-field label { color: #64748b; font-size: 0.78rem; font-weight: 600; text-transform: uppercase; }
        .eod-field input, .eod-field select { border: 1px solid #cbd5e1; border-radius: 6px; padding: 9px 10px; font: inherit; color: #1e293b; background: #fff; }
        .eod-reading-bar { display: flex; gap: 8px; padding: 6px; background: #e2e8f0; border-radius: 10px; margin-bottom: 20px; }
        .eod-reading-button { flex: 1; border: 0; border-radius: 7px; padding: 11px 15px; background: transparent; color: #475569; font: inherit; font-weight: 600; cursor: pointer; }
        .eod-reading-button.active { color: #1d4ed8; background: #fff; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15); }
        .eod-receipt { width: min(100%, 510px); margin: 0 auto; padding: 26px; box-sizing: border-box; color: #111827; background: #fff; border: 1px dashed #94a3b8; font-family: 'Courier New', Courier, monospace; font-size: 0.86rem; line-height: 1.5; }
        .eod-receipt h3, .eod-receipt p { margin: 0; }
        .eod-receipt-head { text-align: center; padding-bottom: 12px; border-bottom: 1px dashed #111827; }
        .eod-receipt-title { letter-spacing: 1px; font-size: 1.15rem; }
        .eod-receipt-meta { padding: 10px 0; border-bottom: 1px dashed #111827; }
        .eod-receipt-line { display: flex; justify-content: space-between; gap: 14px; }
        .eod-receipt-line span:last-child { text-align: right; }
        .eod-receipt-section { padding: 10px 0; border-bottom: 1px dashed #111827; }
        .eod-receipt-total { font-size: 1rem; font-weight: bold; padding: 6px 0; border-top: 1px solid #111827; border-bottom: 1px solid #111827; }
        .eod-transaction { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 7px 0; border-bottom: 1px dotted #94a3b8; }
        .eod-transaction small { color: #475569; grid-column: 1 / -1; }
        .eod-empty { text-align: center; color: #64748b; padding: 20px 0; }
        .eod-actions { display: flex; justify-content: center; margin-top: 16px; }

        .registry-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
        .registry-header h2 { margin: 0; font-size: 1.35rem; }
        .registry-header p { margin: 5px 0 0; color: #64748b; font-size: 0.9rem; }
        .registry-actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .registry-btn { display: inline-flex; align-items: center; justify-content: center; padding: 9px 12px; border-radius: 6px; border: 1px solid #e5e7eb; background: #f3f4f6; color: #334155; font: inherit; font-size: 0.86rem; font-weight: 600; text-decoration: none; cursor: pointer; }
        .registry-btn.primary { color: #fff; border-color: #2563eb; background: #2563eb; }
        .registry-metrics { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: 12px; margin-bottom: 18px; }
        .registry-metric { padding: 16px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; }
        .registry-metric span { display: block; color: #64748b; font-size: 0.78rem; font-weight: 600; text-transform: uppercase; }
        .registry-metric strong { display: block; margin-top: 6px; color: #0f172a; font-size: 1.45rem; }
        .registry-import { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, .8fr); gap: 20px; align-items: center; }
        .registry-dropzone { padding: 22px; border: 2px dashed #93c5fd; border-radius: 10px; background: #f8fbff; }
        .registry-dropzone input { width: 100%; margin: 10px 0 12px; }
        .registry-note { padding: 17px; border-radius: 10px; background: #f8fafc; color: #475569; font-size: 0.86rem; line-height: 1.55; }
        .registry-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
        .registry-search { min-width: 240px; padding: 9px 11px; border: 1px solid #cbd5e1; border-radius: 6px; font: inherit; }
        .registry-table-wrap { overflow-x: auto; }
        .registry-table { min-width: 1050px; margin-top: 0; }
        .registry-table th { white-space: nowrap; }
        .registry-table .amount { text-align: right; white-space: nowrap; }
        .registry-price-input { width: 92px; padding: 7px; border: 1px solid #cbd5e1; border-radius: 5px; font: inherit; text-align: right; }
        .registry-update-btn { margin-left: 6px; padding: 7px 9px; border: 0; border-radius: 5px; color: #fff; background: #0f766e; cursor: pointer; font-weight: 600; }
        .registry-status { min-height: 20px; margin: 9px 0 0; font-size: 0.86rem; color: #475569; }
        .registry-legacy { display: none; }
        .batch-entry-grid { display: grid; grid-template-columns: repeat(3, minmax(160px, 1fr)); gap: 12px; margin-bottom: 14px; }
        .batch-entry-grid label { display: flex; flex-direction: column; gap: 5px; color: #475569; font-size: .8rem; font-weight: 600; }
        .batch-entry-grid input { padding: 9px; border: 1px solid #cbd5e1; border-radius: 6px; font: inherit; }
        .batch-lines { overflow-x: auto; }
        .batch-lines table { min-width: 980px; margin-top: 0; }
        .batch-lines input { width: 100%; min-width: 85px; padding: 7px; border: 1px solid #cbd5e1; border-radius: 5px; box-sizing: border-box; font: inherit; }
        .batch-remove { border: 0; border-radius: 5px; padding: 7px 9px; color: #b91c1c; background: #fef2f2; font-weight: 600; cursor: pointer; }
        .batch-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }

        .admin-dashboard { max-width: 900px; margin: 0 auto; }
        .admin-dashboard-title { margin: 0 0 6px; font-weight: 600; }
        .admin-dashboard-subtitle { margin: 0 0 20px; color: #64748b; font-size: 0.92rem; }
        .admin-tabs { display: flex; gap: 8px; padding: 6px; margin-bottom: 18px; background: #e2e8f0; border-radius: 10px; }
        .admin-tab { flex: 1; padding: 10px 14px; border: 0; border-radius: 7px; background: transparent; color: #475569; font: inherit; font-size: 0.9rem; font-weight: 500; cursor: pointer; }
        .admin-tab.active { background: #fff; color: #2563eb; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15); }
        .admin-tab-panel { display: none; background: #fff; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; }
        .admin-tab-panel.active { display: block; }

        /* Phone and tablet layout */
        @media (max-width: 768px) {
            body { height: auto; min-height: 100vh; overflow: auto; }
            .pos-header { height: auto; min-height: 50px; padding: 10px 14px; gap: 8px; flex-wrap: wrap; }
            .pos-header h2 { font-size: 1rem; min-width: 0; }
            .pos-header h2 span:first-of-type { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 175px; }
            .pos-header .user-info { width: 100%; justify-content: space-between; gap: 8px; font-size: 0.82rem; }

            .app-layout { display: block; height: auto; overflow: visible; }
            .sidebar { width: 100%; flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid #334155; }
            .sidebar-title { display: none; }
            .menu-item { flex: 0 0 auto; padding: 12px 14px; border-left: 0; border-bottom: 3px solid transparent; font-size: 0.8rem; white-space: nowrap; }
            .menu-item.active { border-left-color: transparent; border-bottom-color: #38bdf8; }

            .content-area, .module-pane, .module-pane.active { height: auto; min-height: 0; overflow: visible; }
            .module-pane.active { display: block; }
            .pos-main-container { display: flex; height: auto; flex-direction: column; }
            .left-panel, .right-panel { width: 100%; box-sizing: border-box; }
            .left-panel { border-right: 0; border-bottom: 1px solid #cbd5e1; }
            .cart-section { max-height: 260px; min-height: 120px; }
            .right-panel { min-height: 420px; overflow: visible; }
            .products-grid-container { grid-template-columns: repeat(auto-fill, minmax(125px, 1fr)); overflow: visible; }
            .product-tile { min-height: 105px; height: auto; }

            .module-content { padding: 14px; overflow: visible; box-sizing: border-box; }
            .card { padding: 15px; margin-bottom: 14px; overflow-x: auto; }
            table { min-width: 580px; }
            .cart-table { min-width: 440px; }
            .modal-overlay { align-items: flex-end; }
            .modal-card { width: 100%; max-width: none; max-height: 90vh; overflow-y: auto; box-sizing: border-box; border-radius: 16px 16px 0 0; padding: 20px; }
            #receiptModal .modal-card { width: 100% !important; }
            .admin-tabs { overflow-x: auto; }
            .admin-tab { flex: 0 0 auto; white-space: nowrap; }
            .admin-tab-panel { padding: 15px; }
            .registry-metrics { grid-template-columns: repeat(2, minmax(130px, 1fr)); }
            .registry-import { grid-template-columns: 1fr; }
            .batch-entry-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 420px) {
            .pos-header h2 span:first-of-type { max-width: 125px; }
            .pos-header h2 span:last-child { display: none; }
            .products-grid-container { padding: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
            .categories-bar { padding: 10px; }
            .cat-btn { padding: 8px 12px; }
            .keypad-container { padding: 8px; }
            .key-btn { min-height: 44px; padding: 10px 6px; }
            .payment-methods-grid { gap: 6px; }
            .pay-card { padding: 10px 4px; font-size: 0.85rem; }
        }
    </style>
</head>
<body>

    <div class="pos-header">
        <h2 style="display:flex; align-items:center; gap:10px;">
            <% if (settings.app_logo_url) { %>
                <img src="<%= settings.app_logo_url %>" alt="Logo" style="height:28px; width:auto; border-radius:6px; object-fit:contain; background:#fff; padding:2px;" />
            <% } %>
            <span><%= settings.app_name || 'RxPOS' %></span>
            <span style="font-size: 0.8rem; background: #1abc9c; padding: 2px 8px; border-radius: 4px; font-weight: 400;">Enterprise</span>
        </h2>
        <div class="user-info">
            <span class="clock" id="live-clock"></span>
            <span>Cashier: <strong><%= user %></strong></span>
            <a href="/logout">Log Out</a>
        </div>
    </div>

    <div class="app-layout">
        
        <div class="sidebar">
            <div class="sidebar-title">Modules</div>
            <% const allPages = ['pos', 'inventory', 'prescriptions', 'sales', 'end_of_day', 'admin', 'users']; %>
            <% let activeAllowedPages = typeof allowedPages !== 'undefined' && Array.isArray(allowedPages) ? allowedPages : []; %>
            <% if (['superadmin', 'admin'].includes(role)) { activeAllowedPages = allPages; } %>
            <% const firstAllowedPage = activeAllowedPages.length > 0 ? activeAllowedPages[0] : null; %>
            <% const menuItems = [
                { key: 'pos', label: '🛒 Point of Sale' },
                { key: 'inventory', label: '📦 Imbentaryo & Produkto' },
                { key: 'prescriptions', label: '📋 Reseta (Rx)' },
                { key: 'sales', label: '📊 Sales History' },
                { key: 'admin', label: '⚙️ Admin Branding' },
                { key: 'users', label: '👥 User Access' }
                , { key: 'end_of_day', label: 'End of Day' }
            ]; %>
            <% menuItems.forEach(item => { %>
                <% if (activeAllowedPages.includes(item.key)) { %>
                    <div class="menu-item <%= item.key === firstAllowedPage ? 'active' : '' %>" onclick="switchModule('<%= item.key %>', this)"><%= item.label %></div>
                <% } %>
            <% }); %>
        </div>

        <div class="content-area">
            <% const shownUsers = typeof usersList !== 'undefined' ? usersList : []; %>
            <% const shownPermissions = typeof userPermissions !== 'undefined' ? userPermissions : {}; %>
            <% if (activeAllowedPages && activeAllowedPages.length > 0) { %>
                <% if (activeAllowedPages.includes('pos')) { %>
                    <div id="pane-pos" class="module-pane <%= firstAllowedPage === 'pos' ? 'active' : '' %>">
                <div class="pos-main-container">
                    <div class="left-panel">
                        <div class="cart-section">
                            <table class="cart-table">
                               <thead>
                                    <tr><th>Product</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr>
                                </thead>
                                <tbody id="cart-items"></tbody>
                            </table>
                        </div>
                        <div>
                            <div class="cart-summary">
                                <div class="summary-row"><span>Discount:</span><span style="color: #e11d48;">-₱<span id="cart-discount">0.00</span></span></div>
                                <div class="summary-row total"><span>Total:</span><span style="color: #10b981;">₱<span id="cart-total">0.00</span></span></div>
                            </div>
                            <div class="keypad-container">
                                <button class="key-btn" onclick="appendKey('1')">1</button>
                                <button class="key-btn" onclick="appendKey('2')">2</button>
                                <button class="key-btn" onclick="appendKey('3')">3</button>
                                <button class="key-btn action" id="btn-qty" onclick="setMode('qty')">Qty</button>
                                <button class="key-btn" onclick="appendKey('4')">4</button>
                                <button class="key-btn" onclick="appendKey('5')">5</button>
                                <button class="key-btn" onclick="appendKey('6')">6</button>
                                <button class="key-btn action" id="btn-disc" onclick="setMode('disc')">Disc</button>
                                <button class="key-btn" onclick="appendKey('7')">7</button>
                                <button class="key-btn" onclick="appendKey('8')">8</button>
                                <button class="key-btn" onclick="appendKey('9')">9</button>
                                <button class="key-btn action" id="btn-price" onclick="setMode('price')">Price</button>
                                <button class="key-btn" onclick="clearCartInput()">C</button>
                                <button class="key-btn action" onclick="voidSelectedItem()">Void Item</button>
                                <button class="key-btn action" onclick="clearCart()">Clear Cart</button>
                                <button class="key-btn" onclick="appendKey('0')">0</button>
                                <button class="key-btn" onclick="appendKey('.')">.</button>
                                <button class="key-btn action" onclick="deleteLastInput()">⌫</button>
                                <button class="key-btn payment" onclick="openPaymentModal()">PAYMENT / CHECKOUT</button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="right-panel">
                        <div class="categories-bar">
                            <button class="cat-btn active">All Medicines</button>
                            <button class="cat-btn">OTC</button>
                            <button class="cat-btn">Prescription (Rx)</button>
                        </div>
                        <div style="display:flex; gap:8px; align-items:center; padding: 12px 15px;">
                            <input id="pos-product-search" class="form-control" placeholder="Search product, SKU, barcode..." oninput="filterProductTiles()">
                            <button class="registry-btn" type="button" onclick="filterProductTiles()">Search</button>
