                        <form action="/add-prescription" method="POST">
                            <input type="text" name="patient_name" class="form-control" placeholder="Pangalan ng Pasyente" required>
                            <input type="text" name="doctor_name" class="form-control" placeholder="Pangalan ng Doktor" required>
                            <input type="text" name="medicine_name" class="form-control" placeholder="Resetang Gamot" required>
                            <button type="submit" class="btn" style="background: #2980b9; width: 100%;">Save Prescription</button>
                        </form>
                    </div>
                    <div class="card" style="max-width: 800px; margin: 0 auto;">
                        <h3>Mga Nakaraang Reseta</h3>
                        <table>
                            <thead><tr><th>ID</th><th>Pasyente</th><th>Doktor</th><th>Gamot</th><th>Petsa</th></tr></thead>
                            <tbody>
                                <% prescriptions.forEach(rx => { %>
                                    <tr>
                                        <td>#<%= rx.id %></td>
                                        <td><%= rx.patient_name %></td>
                                        <td><%= rx.doctor_name %></td>
                                        <td><%= rx.medicine_name %></td>
                                        <td><%= rx.date %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <% } %>
            <% if (activeAllowedPages.includes('sales')) { %>
            <div id="pane-sales" class="module-pane <%= firstAllowedPage === 'sales' ? 'active' : '' %>">
                <div class="module-content">
                    <div class="card" style="max-width: 900px; margin: 0 auto;">
                        <h3>Sales History & Logs <span style="font-size: 0.8rem; color: #64748b; font-weight: normal;">(Click a row to view the receipt)</span></h3>
                        <table>
                            <thead><tr><th>Sale ID</th><th>Total Amount</th><th>Cashier</th><th>Date</th></tr></thead>
                            <tbody>
                                <% sales.forEach(s => { %>
                                    <tr class="sales-row" onclick='viewReceipt(<%- s.receipt_data %>)'>
                                        <td>#<%= s.id %></td>
                                        <td style="color: #27ae60; font-weight: bold;">₱<%= Number(s.total).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></td>
                                        <td><%= s.cashier %></td>
                                        <td><%= s.date %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% } %>
            <% } %>
            <% if (activeAllowedPages.includes('end_of_day')) { %>
            <div id="pane-end_of_day" class="module-pane <%= firstAllowedPage === 'end_of_day' ? 'active' : '' %>">
                <div class="module-content">
                    <div class="eod-page">
                        <div class="card">
                            <h3>End of Day Reading</h3>
                            <p style="margin-top:-8px; color:#64748b; font-size:0.9rem;">Select a date range and reading type, then print the report when ready.</p>
                            <div class="eod-toolbar">
                                <div class="eod-field"><label for="eod-from">From</label><input id="eod-from" type="date"></div>
                                <div class="eod-field"><label for="eod-to">To</label><input id="eod-to" type="date"></div>
                                <div class="eod-field" id="eod-cashier-field"><label for="eod-cashier">Cashier</label><select id="eod-cashier"></select></div>
                                <button class="btn" type="button" onclick="renderEndOfDayReading()">Apply Filter</button>
                            </div>
                            <div class="eod-reading-bar" role="tablist" aria-label="Reading type">
                                <button id="eod-x-button" class="eod-reading-button active" type="button" onclick="setEndOfDayMode('x')">X-Reading <small>(per cashier)</small></button>
                                <button id="eod-z-button" class="eod-reading-button" type="button" onclick="setEndOfDayMode('z')">Z-Reading <small>(all cashiers)</small></button>
                            </div>
                            <div id="eod-receipt" class="eod-receipt" aria-live="polite"></div>
                            <div class="eod-actions"><button class="btn" type="button" onclick="printEndOfDayReading()">Print Reading</button></div>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
            <% } %>
            <% if (activeAllowedPages.length === 0) { %>
                <div class="module-pane active">
                    <div class="module-content">
                        <div class="card" style="max-width: 700px; margin: 40px auto; text-align: center;">
                            <h3>Walang Module Access</h3>
                            <p style="color: #475569;">Wala kang pahintulot sa anumang module. Makipag-ugnayan sa admin para mabigyan ng access.</p>
                        </div>
                    </div>
                </div>
            <% } %>

        </div>
    </div>

    <% const permissionsData = typeof userPermissions !== 'undefined' && userPermissions ? userPermissions : {}; %>
    <script>
        const permissionsData = <%- JSON.stringify(permissionsData) %>;

        const userAccessSelect = document.getElementById('user-access-select');
        if (userAccessSelect) {
            userAccessSelect.addEventListener('change', function() {
                const user = this.value;
                const selectedPermissions = permissionsData[user] || [];

                document.getElementById('check-pos').checked = selectedPermissions.includes('pos');
                document.getElementById('check-inventory').checked = selectedPermissions.includes('inventory');
                document.getElementById('check-prescriptions').checked = selectedPermissions.includes('prescriptions');
                document.getElementById('check-sales').checked = selectedPermissions.includes('sales');
                document.getElementById('check-admin').checked = selectedPermissions.includes('admin');
                document.getElementById('check-users').checked = selectedPermissions.includes('users');
            });
        }
    </script>

    <div id="paymentModal" class="modal-overlay">
        <div class="modal-card">
            <h3>Payment & Checkout</h3>
            
            <div class="modal-row">
                <label>Total Payable Amount</label>
                <input type="text" id="modal-total-display" readonly style="font-weight: bold; color: #10b981; background: #f8fafc;">
            </div>

            <div class="modal-row">
                <label>Mode of Payment (Tap to Select)</label>
                <div class="payment-methods-grid">
                    <div class="pay-card active" id="method-Cash" onclick="selectPaymentMethod('Cash')">Cash</div>
                    <div class="pay-card" id="method-GCash" onclick="selectPaymentMethod('GCash')">GCash</div>
                    <div class="pay-card" id="method-Card" onclick="selectPaymentMethod('Card')">Card</div>
                </div>
            </div>

            <div class="modal-row" id="cash-tendered-row">
                <label>Amount Tendered (Cash)</label>
                <input type="number" id="modal-tendered" placeholder="0.00" oninput="computeChange()">
            </div>

            <div class="modal-row">
                <label>Change (Sukli)</label>
