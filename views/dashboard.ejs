                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
            <% if (activeAllowedPages.includes('inventory')) { %>
            <div id="pane-inventory" class="module-pane <%= firstAllowedPage === 'inventory' ? 'active' : '' %>">
                <div class="module-content">
                    <% const registryPotentialRevenue = products.reduce((total, product) => total + ((Number(product.price) || 0) - (Number(product.cost) || 0)) * (Number(product.stock) || 0), 0); %>
                    <div class="registry-header">
                        <div><h2>Product Registry</h2><p>Upload a standard Excel product file, update prices strategically, and download current reports.</p></div>
                        <div class="registry-actions"><a class="registry-btn" href="/inventory/export.xlsx">Download Excel</a><a class="registry-btn" href="/inventory/export.pdf">Download PDF</a><button class="registry-btn" type="button" onclick="openPriceUpdateSelector()">Price Update</button><button class="registry-btn" type="button" onclick="openDeliveryModal()">Receive Delivery</button></div>
                    </div>
                    <div class="registry-metrics">
                        <div class="registry-metric"><span>Registered items</span><strong><%= inventorySummary.totalProducts %></strong></div>
                        <div class="registry-metric"><span>Stock value</span><strong>PHP <%= Number(inventorySummary.totalStockValue).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></strong></div>
                        <div class="registry-metric"><span>Low stock</span><strong><%= inventorySummary.lowStockCount %></strong></div>
                        <div class="registry-metric"><span>Possible revenue</span><strong>PHP <%= Number(registryPotentialRevenue).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></strong></div>
                    </div>
                    <div class="card registry-import">
                        <form id="registry-import-form" class="registry-dropzone">
                            <h3 style="margin:0;">Mass upload products</h3><p style="margin:7px 0; color:#475569; font-size:.88rem;">Excel rows matching an existing SKU or barcode are updated. New rows are added.</p>
                            <input id="registry-file" name="product_file" type="file" accept=".xlsx,.xls" required>
                            <button type="submit" class="registry-btn primary">Import Product File</button><div id="registry-import-status" class="registry-status"></div>
                        </form>
                        <div class="registry-note"><strong>Required headers</strong><br>Item, SKU, Barcode, Description, Cost, Price<br><br><strong>Supported calculated headers:</strong> Margin %, Margin in %, Possible Revenue.<br><br><strong>Optional:</strong> Stock. Margin and Possible Revenue are always calculated by the system. Download Excel first for the correct column structure.</div>
                    </div>
                    <div class="card">
                        <h3 style="margin:0 0 5px;">Manual Batch Entry</h3>
                        <p style="margin:0 0 15px; color:#64748b; font-size:.88rem;">Set the batch information once, then use <strong>Add line</strong> to keep entering products under the same batch number.</p>
                        <form id="manual-batch-form">
                            <div class="batch-entry-grid">
                                <label>Batch Number<input id="manual-batch-number" type="text" required placeholder="e.g. BATCH-2026-001"></label>
                                <label>Category<input id="manual-batch-category" type="text" value="General" required></label>
                                <label>Expiry Date<input id="manual-batch-expiry" type="date"></label>
                            </div>
                            <div class="batch-lines"><table><thead><tr><th>Item</th><th>SKU</th><th>Barcode</th><th>Description</th><th>Cost</th><th>Price</th><th>Stock</th><th></th></tr></thead><tbody id="manual-batch-lines"></tbody></table></div>
                            <div class="batch-actions"><button class="registry-btn" type="button" onclick="addManualBatchLine()">+ Add line</button><button class="registry-btn primary" type="submit">Save Product Batch</button></div>
                            <div id="manual-batch-status" class="registry-status"></div>
                        </form>
                    </div>
                    <div class="card">
                        <div class="registry-toolbar"><div><h3 style="margin:0;">Registry List</h3><small style="color:#64748b;">Margin = (Price − Cost) ÷ Price. Possible revenue is projected profit from available stock.</small></div><input id="registry-search" class="registry-search" type="search" placeholder="Search item, SKU, barcode..." oninput="filterRegistryRows()"></div>
                        <div class="registry-table-wrap"><table class="registry-table"><thead><tr><th>Item</th><th>SKU</th><th>Barcode</th><th>Description</th><th class="amount">Cost</th><th class="amount">Price</th><th class="amount">Margin %</th><th class="amount">Possible Revenue</th><th>Price Update</th><th></th></tr></thead><tbody id="registry-rows">
                        <% products.forEach(product => { const cost = Number(product.cost) || 0; const price = Number(product.price) || 0; const margin = price ? ((price - cost) / price) * 100 : 0; const possibleRevenue = (price - cost) * (Number(product.stock) || 0); %>
                            <tr data-registry-search="<%= [product.name, product.sku, product.barcode, product.description].join(' ').toLowerCase() %>"><td><strong><%= product.name %></strong><br><small style="color:#64748b;">Stock: <%= product.stock %></small></td><td><%= product.sku || '—' %></td><td><%= product.barcode || '—' %></td><td><%= product.description || '—' %></td><td class="amount">PHP <%= Number(cost).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></td><td class="amount">PHP <%= Number(price).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></td><td class="amount"><%= margin.toFixed(1) %>%</td><td class="amount">PHP <%= Number(possibleRevenue).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></td><td><input id="price-<%= product.id %>" class="registry-price-input" type="number" min="0" step="0.01" value="<%= price.toFixed(2) %>"><button class="registry-update-btn" type="button" onclick="updateRegistryPrice(<%= product.id %>)">Update</button></td><td><button class="registry-btn" type="button" onclick="openPriceUpdateModal('<%= product.id %>', '<%= product.name.replace(/'/g, "\\'") %>', '<%= price.toFixed(2) %>')">Edit</button></td></tr>
                        <% }) %>
                        </tbody></table></div>
                    </div>
                    <div id="price-update-selector-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="price-update-selector-title">
                        <div class="modal-card" style="width: min(95vw, 920px);">
                            <h3 id="price-update-selector-title">Update Product Prices</h3>
                            <div class="modal-row"><input id="price-update-filter" type="search" class="form-control" placeholder="Search item, SKU, barcode..." oninput="filterPriceUpdateSelectorRows()"></div>
                            <div style="max-height:420px; overflow:auto; margin-top: 10px;">
                                <table class="registry-table" style="width:100%; min-width: 720px;">
                                    <thead><tr><th>Item</th><th>SKU</th><th>Old Price</th><th>New Price</th><th>Actions</th></tr></thead>
                                    <tbody id="price-update-selector-rows">
                                        <% products.forEach(product => { const price = Number(product.price) || 0; %>
                                            <tr data-price-selector-search="<%= [product.name, product.sku, product.barcode, product.description].join(' ').toLowerCase() %>">
                                                <td><strong><%= product.name %></strong><br><small style="color:#64748b;">Stock: <%= product.stock %></small></td>
                                                <td><%= product.sku || '—' %></td>
                                                <td class="amount">PHP <%= Number(price).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></td>
                                                <td><input id="selector-price-<%= product.id %>" type="number" min="0" step="0.01" class="form-control" value="<%= price.toFixed(2) %>"></td>
                                                <td style="white-space:nowrap; display:flex; gap:8px;">
                                                    <button class="registry-btn" type="button" onclick="savePriceUpdateFromSelector('<%= product.id %>', '<%= product.name.replace(/'/g, "\\'") %>')">Save</button>
                                                    <button class="registry-btn" type="button" onclick="openPriceUpdateModal('<%= product.id %>', '<%= product.name.replace(/'/g, "\\'") %>', '<%= price.toFixed(2) %>')">History</button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-actions"><button class="btn btn-cancel" type="button" onclick="closePriceUpdateSelector()">Close</button></div>
                        </div>
                    </div>
                    <!-- Delivery receive modal -->
                    <div id="delivery-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="delivery-title" style="display:none;">
                        <div class="modal-card" style="width: min(95vw, 920px);">
                            <h3 id="delivery-title">Receive Delivery</h3>
                            <div class="modal-row"><label>Receipt No<input id="delivery-receipt-no" class="form-control" placeholder="Enter delivery receipt number"></label></div>
                            <div style="margin-top:8px;">
                                <table class="registry-table" style="width:100%; min-width: 720px;">
                                    <thead><tr><th>Product</th><th>SKU</th><th>Current Stock</th><th>Qty Received</th><th></th></tr></thead>
                                    <tbody id="delivery-lines">
                                        <tr>
                                            <td>
                                                <select class="form-control" data-line-index="0" id="delivery-product-0" onchange="deliveryProductChanged(this)">
                                                    <option value="">-- select product --</option>
                                                    <% products.forEach(p => { %>
                                                        <option value="<%= p.id %>" data-sku="<%= p.sku %>" data-name="<%= p.name.replace(/'/g, "\\'") %>" data-stock="<%= p.stock %>"><%= p.name %> (<%= p.sku || '—' %>)</option>
                                                    <% }) %>
                                                </select>
                                            </td>
                                            <td><input id="delivery-sku-0" class="form-control" readonly></td>
                                            <td><input id="delivery-stock-0" class="form-control" readonly></td>
                                            <td><input id="delivery-qty-0" class="form-control" type="number" min="0" value="0"></td>
                                            <td><button class="registry-btn" type="button" onclick="removeDeliveryLine(this)">Remove</button></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div style="margin-top:10px;"><button class="registry-btn" type="button" onclick="addDeliveryLine()">+ Add line</button></div>
                            </div>
                            <div class="modal-actions" style="margin-top:12px;"><button class="btn btn-cancel" type="button" onclick="closeDeliveryModal()">Cancel</button><button class="btn btn-confirm" type="button" onclick="saveDelivery()">Receive & Print</button></div>
                            <div id="delivery-status" style="margin-top:10px; color:#475569;"></div>
                        </div>
                    </div>

                    <div id="price-update-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="price-update-title">
                        <div class="modal-card">
                            <h3 id="price-update-title">Update Product Price</h3>
                            <div class="modal-row"><label>Item<input id="price-update-item" type="text" readonly></label></div>
                            <div class="modal-row"><label>Old Price<input id="price-update-old" type="text" readonly></label></div>
                            <div class="modal-row"><label>New Price<input id="price-update-new" type="number" min="0" step="0.01"></label></div>
                            <div class="modal-row"><label>Change Log</label><div id="price-update-log" style="max-height:220px; overflow:auto; padding:12px; border:1px solid #cbd5e1; border-radius:8px; background:#f8fafc;"></div></div>
                            <div class="modal-actions"><button class="btn btn-cancel" type="button" onclick="closePriceUpdateModal()">Cancel</button><button class="btn btn-confirm" type="button" onclick="savePriceUpdate()">Save Price</button></div>
                            <div id="price-update-status" style="margin-top:10px; color:#475569;"></div>
                        </div>
                    </div>
                    <div class="registry-legacy" aria-hidden="true">
                    <div class="card" style="display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 20px;">
                        <div style="background: #eef2ff; padding: 18px; border-radius: 12px;">
                            <h3 style="margin-top:0;">Kabuuang Produkto</h3>
                            <p style="font-size: 2rem; font-weight: 700; margin: 8px 0 0 0;"><%= inventorySummary.totalProducts %></p>
                        </div>
                        <div style="background: #f5f3ff; padding: 18px; border-radius: 12px;">
                            <h3 style="margin-top:0;">Kabuuang Halaga ng Stock</h3>
                            <p style="font-size: 2rem; font-weight: 700; margin: 8px 0 0 0;">₱<%= Number(inventorySummary.totalStockValue).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) %></p>
                        </div>
                        <div style="background: #ffefeb; padding: 18px; border-radius: 12px;">
                            <h3 style="margin-top:0;">Mababang Stock</h3>
                            <p style="font-size: 2rem; font-weight: 700; margin: 8px 0 0 0;"><%= inventorySummary.lowStockCount %></p>
                            <small style="color: #475569;">Threshold: <%= inventorySummary.lowStockThreshold %> units</small>
                        </div>
                        <div style="background: #ecfdf5; padding: 18px; border-radius: 12px;">
                            <h3 style="margin-top:0;">Reseta na Produkto</h3>
                            <p style="font-size: 2rem; font-weight: 700; margin: 8px 0 0 0;"><%= inventorySummary.prescriptionCount %></p>
                        </div>
                    </div>

                    <div class="card" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div style="min-width: 0;">
                            <h3>Add New Product</h3>
                            <form action="/add-product" method="POST">
                                <input type="text" name="name" class="form-control" placeholder="Pangalan ng Gamot" required>
                                <input type="text" name="category" class="form-control" placeholder="Kategorya (OTC / Prescription)" required>
                                <input type="number" step="0.01" name="price" class="form-control" placeholder="Presyo (₱)" required>
                                <input type="number" name="stock" class="form-control" placeholder="Dami ng Stock" required>
                                <input type="text" name="batch_no" class="form-control" placeholder="Batch / Lot Number" required>
                                <input type="date" name="expiry_date" class="form-control" required>
                                <label style="font-size: 0.9rem; display: block; margin-bottom: 15px;"><input type="checkbox" name="requires_prescription" value="1"> Requires Prescription (Rx)?</label>
                                <button type="submit" class="btn" style="background: #8e44ad; width: 100%;">Save to Inventory</button>
