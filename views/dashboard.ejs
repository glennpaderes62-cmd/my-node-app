                    <div style="display: flex; justify-content: space-between;"><span>VAT Amount (12%):</span> <span>₱<span id="rec-vat">0.00</span></span></div>
                    <div style="display: flex; justify-content: space-between;"><span>VAT-Exempt Sales:</span> <span>₱0.00</span></div>
                    <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 1.1rem; margin-top: 6px; border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 4px 0;">
                        <span>TOTAL AMOUNT DUE:</span> <span>₱<span id="rec-total">0.00</span></span>
                    </div>
