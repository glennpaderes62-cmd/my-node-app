    <script>
        function switchModule(moduleName, element) {
            document.querySelectorAll('.module-pane').forEach(pane => pane.classList.remove('active'));
            document.querySelectorAll('.menu-item').forEach(item => item.classList.remove('active'));

            document.getElementById('pane-' + moduleName).classList.add('active');
            element.classList.add('active');
        }

        function switchAdminTab(tabName, element) {
            document.querySelectorAll('.admin-tab-panel').forEach(panel => panel.classList.remove('active'));
            document.querySelectorAll('.admin-tab').forEach(tab => {
                tab.classList.remove('active');
                tab.setAttribute('aria-selected', 'false');
            });
            document.getElementById('admin-tab-' + tabName).classList.add('active');
            element.classList.add('active');
            element.setAttribute('aria-selected', 'true');
        }

        let cart = [];
        let selectedIndex = null;
        let activeInputMode = 'qty';
        let currentInputValue = '';
        let selectedPaymentMethod = 'Cash';

        function selectPaymentMethod(method) {
            selectedPaymentMethod = method;
            document.querySelectorAll('.pay-card').forEach(c => c.classList.remove('active'));
            document.getElementById('method-' + method).classList.add('active');

            let tenderedRow = document.getElementById('cash-tendered-row');
            if (method !== 'Cash') {
                tenderedRow.style.display = 'none';
                let total = cart.reduce((sum, item) => sum + ((item.price * item.qty) - (item.discount || 0)), 0);
                document.getElementById('modal-tendered').value = total;
                document.getElementById('modal-change').value = '₱0.00 (Exact)';
            } else {
                tenderedRow.style.display = 'block';
                document.getElementById('modal-tendered').value = '';
                document.getElementById('modal-change').value = '₱0.00';
                document.getElementById('modal-tendered').focus();
            }
        }

        function setMode(mode) {
            activeInputMode = mode;
            currentInputValue = '';
            document.querySelectorAll('.key-btn.action').forEach(b => b.classList.remove('active-mode'));
            document.getElementById('btn-' + mode).classList.add('active-mode');
        }

        function startLiveClock(){
            const el = document.getElementById('live-clock');
            if (!el) return;
            function tick(){ el.textContent = new Date().toLocaleTimeString(); }
            tick();
            setInterval(tick, 1000);
        }
        startLiveClock();

        function addToCart(id, name, price, stock, requiresRx) {
            // Prevent adding items with zero stock
            if (Number(stock) <= 0) {
                alert('Item is out of stock.');
                return;
            }

            if (requiresRx === '1') {
                let hasRx = confirm(`The item "${name}" requires a prescription (Rx). Does the patient have one?`);
                if (!hasRx) {
                    alert('Cannot add without prescription.');
                    return;
                }
            }

            let item = cart.find(i => i.id === id);
            if (item) {
                if (item.qty + 1 > stock) {
                    alert('Insufficient stock for this item!');
                    return;
                }
                item.qty++;
            } else {
                cart.push({ id, name, price, originalPrice: price, qty: 1, discount: 0 });
            }
            selectedIndex = cart.length - 1;
            updateCartUI();
        }

        function clearCart(){
            if (!confirm('Clear entire cart?')) return;
            cart = [];
            selectedIndex = null;
            updateCartUI();
        }

        function voidSelectedItem(){
            if (selectedIndex === null) { alert('No item selected to void.'); return; }
            if (!confirm('Void selected item?')) return;
            cart.splice(selectedIndex, 1);
            if (cart.length === 0) selectedIndex = null;
            else selectedIndex = Math.min(selectedIndex, cart.length - 1);
            updateCartUI();
        }

        function selectItem(index) {
            selectedIndex = index;
            currentInputValue = '';
            updateCartUI();
        }

        function appendKey(val) {
            if (selectedIndex === null && cart.length > 0) {
                selectedIndex = 0;
            }
            if (selectedIndex === null) return;

            currentInputValue += val;
            applyInputModeValue();
        }

        function deleteLastInput() {
            if (currentInputValue.length > 0) {
                currentInputValue = currentInputValue.slice(0, -1);
                applyInputModeValue();
            }
        }

        function clearCartInput() {
            currentInputValue = '';
            if (selectedIndex !== null) {
                if (activeInputMode === 'qty') cart[selectedIndex].qty = 1;
                if (activeInputMode === 'disc') cart[selectedIndex].discount = 0;
                if (activeInputMode === 'price') cart[selectedIndex].price = cart[selectedIndex].originalPrice;
                updateCartUI();
            }
        }

        function applyInputModeValue() {
            if (selectedIndex === null || currentInputValue === '') return;
            let val = parseFloat(currentInputValue);
            if (isNaN(val)) return;

            let item = cart[selectedIndex];
            if (activeInputMode === 'qty') {
                item.qty = val;
            } else if (activeInputMode === 'disc') {
                item.discount = val;
            } else if (activeInputMode === 'price') {
                item.price = val;
            }
            updateCartUI();
        }

        function updateCartUI() {
            let tbody = document.getElementById('cart-items');
            let totalSpan = document.getElementById('cart-total');
            let discountSpan = document.getElementById('cart-discount');
            tbody.innerHTML = '';
            let total = 0;
            let totalDiscount = 0;

            cart.forEach((item, index) => {
                let itemTotal = (item.price * item.qty) - (item.discount || 0);
                total += itemTotal;
                totalDiscount += (item.discount || 0);

                let isSelected = index === selectedIndex ? 'selected' : '';
                const priceStr = Number(item.price).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
                const itemTotalStr = Number(itemTotal).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
                tbody.innerHTML += `<tr class="${isSelected}" onclick="selectItem(${index})">
                    <td>${item.name}</td>
                    <td>${item.qty}</td>
                    <td>₱${priceStr}</td>
                    <td>₱${itemTotalStr}</td>
                </tr>`;
            });

            totalSpan.innerText = Number(total).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
            discountSpan.innerText = Number(totalDiscount).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
        }

        function openPaymentModal() {
            if (cart.length === 0) {
                alert('Cart is empty!');
                return;
            }
            let total = cart.reduce((sum, item) => sum + ((item.price * item.qty) - (item.discount || 0)), 0);
            document.getElementById('modal-total-display').value = '₱' + total.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
            
            selectPaymentMethod('Cash');
            document.getElementById('paymentModal').style.display = 'flex';
            
            setTimeout(() => {
                let tenderedInput = document.getElementById('modal-tendered');
                tenderedInput.focus();
                tenderedInput.select();
            }, 100);
        }

        function closePaymentModal() {
            document.getElementById('paymentModal').style.display = 'none';
        }

        function computeChange() {
            let total = cart.reduce((sum, item) => sum + ((item.price * item.qty) - (item.discount || 0)), 0);
            let tendered = parseFloat(document.getElementById('modal-tendered').value) || 0;
            let change = tendered - total;
            document.getElementById('modal-change').value = change >= 0 ? '₱' + change.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}) : 'Insufficient payment';
        }

        function confirmCheckout() {
            let total = cart.reduce((sum, item) => sum + ((item.price * item.qty) - (item.discount || 0)), 0);
            let tendered = parseFloat(document.getElementById('modal-tendered').value) || 0;

            if (selectedPaymentMethod === 'Cash' && tendered < total) {
                alert('Insufficient tendered amount!');
                return;
            }

            fetch('/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cart, total, paymentMethod: selectedPaymentMethod, tendered })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closePaymentModal();
                    showReceiptModal(data.receiptData);
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }

        function showReceiptModal(rec) {
            document.getElementById('rec-id').innerText = rec.saleId;
            document.getElementById('rec-date').innerText = rec.date;
            document.getElementById('rec-cashier').innerText = rec.cashier;
            document.getElementById('rec-vatable').innerText = Number(rec.vatableSales).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
            document.getElementById('rec-vat').innerText = Number(rec.vatAmount).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
            document.getElementById('rec-total').innerText = Number(rec.total).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
            document.getElementById('rec-method').innerText = rec.paymentMethod;
            document.getElementById('rec-tendered').innerText = Number(rec.tendered).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
            document.getElementById('rec-change').innerText = Number(rec.change).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});

            let tbody = document.getElementById('rec-items');
            tbody.innerHTML = '';
            rec.cart.forEach(item => {
                let subtotal = (item.price * item.qty) - (item.discount || 0);
                tbody.innerHTML += `<tr>
                    <td>${item.name}</td>
                    <td style="text-align:center;">${item.qty}</td>
                    <td style="text-align:right;">${Number(item.price).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})}</td>
                    <td style="text-align:right;">${Number(subtotal).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})}</td>
                </tr>`;
            });

            document.getElementById('receiptModal').style.display = 'flex';
        }

        function viewReceipt(rec) {
            showReceiptModal(rec);
        }

        function closeReceiptModal() {
            document.getElementById('receiptModal').style.display = 'none';
            location.reload();
        }

        function printReceipt() {
            let printContent = document.getElementById('receipt-content').innerHTML;
            let originalContent = document.body.innerHTML;
            document.body.innerHTML = printContent;
            window.print();
            document.body.innerHTML = originalContent;
            location.reload();
        }

        // End-of-day readings use the existing sale records only; they do not alter sales or inventory.
        const endOfDaySales = <%- JSON.stringify(sales || []).replace(/</g, '\\u003c') %>;
        let endOfDayMode = 'x';

        function escapeEndOfDayHtml(value) {
            return String(value == null ? '' : value).replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
        }

        function endOfDayLocalDate(date) {
            const parsed = new Date(date);
            if (Number.isNaN(parsed.getTime())) return '';
            const year = parsed.getFullYear();
            const month = String(parsed.getMonth() + 1).padStart(2, '0');
            const day = String(parsed.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function endOfDaySaleDate(sale) {
            let receipt = sale.receipt_data;
            try { if (typeof receipt === 'string') receipt = JSON.parse(receipt); } catch (error) { receipt = {}; }
            return endOfDayLocalDate((receipt && receipt.date) || sale.date);
        }

        function endOfDayMoney(value) {
            return `PHP ${Number(value || 0).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})}`;
        }

        function initializeEndOfDay() {
            const from = document.getElementById('eod-from');
            if (!from) return;
            const today = endOfDayLocalDate(new Date());
            from.value = today;
            document.getElementById('eod-to').value = today;

            const cashierSelect = document.getElementById('eod-cashier');
            const cashiers = [...new Set(endOfDaySales.map(sale => sale.cashier || 'Unassigned'))].sort();
            cashierSelect.innerHTML = cashiers.length
                ? cashiers.map(cashier => `<option value="${escapeEndOfDayHtml(cashier)}">${escapeEndOfDayHtml(cashier)}</option>`).join('')
                : '<option value="">No cashier records</option>';
            renderEndOfDayReading();
        }

        function setEndOfDayMode(mode) {
            endOfDayMode = mode;
            document.getElementById('eod-x-button').classList.toggle('active', mode === 'x');
            document.getElementById('eod-z-button').classList.toggle('active', mode === 'z');
            document.getElementById('eod-cashier-field').style.display = mode === 'x' ? 'flex' : 'none';
            renderEndOfDayReading();
        }

        function renderEndOfDayReading() {
            const receipt = document.getElementById('eod-receipt');
            if (!receipt) return;
            const from = document.getElementById('eod-from').value;
            const to = document.getElementById('eod-to').value;
            const cashier = document.getElementById('eod-cashier').value;
            const selectedSales = endOfDaySales.filter(sale => {
                const saleDate = endOfDaySaleDate(sale);
                return saleDate && (!from || saleDate >= from) && (!to || saleDate <= to) && (endOfDayMode === 'z' || sale.cashier === cashier);
            });
            const totals = selectedSales.reduce((summary, sale) => {
                let details = sale.receipt_data;
                try { if (typeof details === 'string') details = JSON.parse(details); } catch (error) { details = {}; }
                const total = Number(sale.total) || Number(details.total) || 0;
                const method = details.paymentMethod || 'Unspecified';
                summary.gross += total;
                summary.vatable += Number(details.vatableSales) || Math.max(0, total / 1.12);
                summary.vat += Number(details.vatAmount) || Math.max(0, total - (total / 1.12));
                summary.payments[method] = (summary.payments[method] || 0) + total;
                return summary;
            }, { gross: 0, vatable: 0, vat: 0, payments: {} });
            const period = `${from || 'Beginning'} to ${to || 'Today'}`;
            const readingName = endOfDayMode === 'x' ? 'X-READING' : 'Z-READING';
            const cashierLabel = endOfDayMode === 'x' ? (cashier || 'No cashier selected') : 'All cashiers';
            const paymentLines = Object.keys(totals.payments).length
                ? Object.entries(totals.payments).map(([method, amount]) => `<div class="eod-receipt-line"><span>${escapeEndOfDayHtml(method)}</span><span>${endOfDayMoney(amount)}</span></div>`).join('')
                : '<div class="eod-receipt-line"><span>No payments</span><span>PHP 0.00</span></div>';
            const transactions = selectedSales.length
                ? selectedSales.map(sale => `<div class="eod-transaction"><span>#${sale.id} · ${escapeEndOfDayHtml(sale.cashier || 'Unassigned')}</span><strong>${endOfDayMoney(sale.total)}</strong><small>${escapeEndOfDayHtml(sale.date || '')}</small></div>`).join('')
                : '<div class="eod-empty">No completed transactions for this selection.</div>';

            receipt.innerHTML = `<div class="eod-receipt-head"><h3>${escapeEndOfDayHtml('<%= settings.app_name || 'RxPOS' %>')}</h3><p class="eod-receipt-title">${readingName}</p><p>END OF DAY SALES READING</p></div><div class="eod-receipt-meta"><div class="eod-receipt-line"><span>Period</span><span>${escapeEndOfDayHtml(period)}</span></div><div class="eod-receipt-line"><span>Cashier</span><span>${escapeEndOfDayHtml(cashierLabel)}</span></div><div class="eod-receipt-line"><span>Printed</span><span>${escapeEndOfDayHtml(new Date().toLocaleString())}</span></div></div><div class="eod-receipt-section"><div class="eod-receipt-line"><span>Transactions</span><span>${selectedSales.length}</span></div><div class="eod-receipt-line eod-receipt-total"><span>GROSS SALES</span><span>${endOfDayMoney(totals.gross)}</span></div><div class="eod-receipt-line"><span>VATable sales</span><span>${endOfDayMoney(totals.vatable)}</span></div><div class="eod-receipt-line"><span>VAT (12%)</span><span>${endOfDayMoney(totals.vat)}</span></div></div><div class="eod-receipt-section"><strong>PAYMENT SUMMARY</strong>${paymentLines}</div><div class="eod-receipt-section"><strong>TRANSACTION LOG</strong>${transactions}</div><div class="eod-receipt-head" style="border:0; padding:12px 0 0;"><p>*** END OF READING ***</p></div>`;
        }

        function printEndOfDayReading() {
            const content = document.getElementById('eod-receipt');
            if (!content) return;
            const printWindow = window.open('', '_blank', 'width=600,height=800');
            if (!printWindow) return alert('Please allow pop-ups to print the End of Day reading.');
            printWindow.document.write(`<html><head><title>End of Day Reading</title><style>body{margin:0;padding:20px;background:#fff}.eod-receipt{max-width:510px;margin:auto;padding:26px;box-sizing:border-box;color:#111827;border:1px dashed #94a3b8;font-family:'Courier New',monospace;font-size:12px;line-height:1.5}.eod-receipt h3,.eod-receipt p{margin:0}.eod-receipt-head{text-align:center;padding-bottom:12px;border-bottom:1px dashed #111827}.eod-receipt-title{letter-spacing:1px;font-size:16px}.eod-receipt-meta,.eod-receipt-section{padding:10px 0;border-bottom:1px dashed #111827}.eod-receipt-line{display:flex;justify-content:space-between;gap:14px}.eod-receipt-total{font-size:14px;font-weight:bold;padding:6px 0;border-top:1px solid #111827;border-bottom:1px solid #111827}.eod-transaction{display:grid;grid-template-columns:1fr auto;gap:2px 12px;padding:7px 0;border-bottom:1px dotted #94a3b8}.eod-transaction small{grid-column:1/-1;color:#475569}.eod-empty{text-align:center;color:#64748b;padding:20px 0}</style></head><body>${content.outerHTML}</body></html>`);
            printWindow.document.close();
            printWindow.focus();
            printWindow.print();
        }

        function addManualBatchLine() {
            const lines = document.getElementById('manual-batch-lines');
            if (!lines) return;
            const row = document.createElement('tr');
            row.innerHTML = '<td><input name="name" placeholder="Product name"></td><td><input name="sku" placeholder="SKU"></td><td><input name="barcode" placeholder="Barcode"></td><td><input name="description" placeholder="Description"></td><td><input name="cost" type="number" min="0" step="0.01" placeholder="0.00"></td><td><input name="price" type="number" min="0" step="0.01" placeholder="0.00"></td><td><input name="stock" type="number" min="0" step="1" value="0"></td><td><button class="batch-remove" type="button" onclick="removeManualBatchLine(this)">Remove</button></td>';
            lines.appendChild(row);
        }

        function removeManualBatchLine(button) {
            const lines = document.getElementById('manual-batch-lines');
            if (lines.children.length === 1) {
                lines.firstElementChild.querySelectorAll('input').forEach(input => { input.value = input.name === 'stock' ? '0' : ''; });
                return;
            }
            button.closest('tr').remove();
        }

        const manualBatchForm = document.getElementById('manual-batch-form');
        if (manualBatchForm) {
            addManualBatchLine();
            manualBatchForm.addEventListener('submit', async event => {
                event.preventDefault();
                const items = [...document.querySelectorAll('#manual-batch-lines tr')].map(row => ({
                    name: row.querySelector('[name="name"]').value, sku: row.querySelector('[name="sku"]').value,
                    barcode: row.querySelector('[name="barcode"]').value, description: row.querySelector('[name="description"]').value,
                    cost: row.querySelector('[name="cost"]').value, price: row.querySelector('[name="price"]').value,
                    stock: row.querySelector('[name="stock"]').value
                }));
                const status = document.getElementById('manual-batch-status');
                status.style.color = '#475569';
                status.textContent = 'Saving batch...';
                try {
                    const response = await fetch('/inventory/manual-batch', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ batch_no: document.getElementById('manual-batch-number').value, category: document.getElementById('manual-batch-category').value, expiry_date: document.getElementById('manual-batch-expiry').value, items })
                    });
                    const result = await response.json();
                    status.style.color = result.success ? '#047857' : '#b91c1c';
                    status.textContent = result.message;
                    if (result.success) setTimeout(() => location.reload(), 900);
                } catch (error) {
                    status.style.color = '#b91c1c';
                    status.textContent = 'Unable to save this batch.';
                }
            });
        }

        const registryImportForm = document.getElementById('registry-import-form');
        if (registryImportForm) {
            registryImportForm.addEventListener('submit', async event => {
                event.preventDefault();
                const status = document.getElementById('registry-import-status');
                const fileInput = document.getElementById('registry-file');
                if (!fileInput.files.length) return;
                status.style.color = '#475569';
                status.textContent = 'Reading product file...';
                try {
                    const response = await fetch('/inventory/import', { method: 'POST', body: new FormData(registryImportForm) });
                    const result = await response.json();
                    status.style.color = result.success ? '#047857' : '#b91c1c';
                    status.textContent = result.message;
                    if (result.success) setTimeout(() => location.reload(), 900);
                } catch (error) {
                    status.style.color = '#b91c1c';
                    status.textContent = 'Upload failed. Please try again.';
                }
            });
        }

        async function updateRegistryPrice(productId) {
            const input = document.getElementById(`price-${productId}`);
            const price = Number(input.value);
            if (!Number.isFinite(price) || price < 0) return alert('Enter a valid non-negative price.');
            try {
                const response = await fetch('/inventory/update-price', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId, price })
                });
                const result = await response.json();
                if (!result.success) return alert(result.message);
                location.reload();
            } catch (error) {
                alert('Unable to update the product price.');
            }
        }

        function openPriceUpdateModal(productId, productName, currentPrice) {
            const modal = document.getElementById('price-update-modal');
            const itemField = document.getElementById('price-update-item');
            const oldField = document.getElementById('price-update-old');
            const newField = document.getElementById('price-update-new');
            const logContainer = document.getElementById('price-update-log');
            const status = document.getElementById('price-update-status');

            if (!modal || !itemField || !oldField || !newField || !logContainer || !status) return;

            modal.style.display = 'flex';
            itemField.value = productName;
            oldField.value = `PHP ${Number(currentPrice).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})}`;
            newField.value = Number(currentPrice).toFixed(2);
            status.textContent = '';
            logContainer.innerHTML = '<p style="margin:0;color:#64748b;">Loading history...</p>';
            modal.dataset.productId = productId;

            fetch(`/inventory/price-history/${productId}`)
                .then((response) => response.json())
                .then((result) => {
                    if (!result.success) {
                        logContainer.innerHTML = `<p style="margin:0;color:#b91c1c;">${result.message}</p>`;
                        return;
                    }

                    if (!result.logs.length) {
                        logContainer.innerHTML = '<p style="margin:0;color:#475569;">No price history yet.</p>';
                        return;
                    }

                    logContainer.innerHTML = result.logs
                        .map((log) => `
                            <div style="margin-bottom:10px; padding:10px; background:#fff; border:1px solid #e2e8f0; border-radius:8px;">
                                <div style="font-size:0.82rem; color:#475569; margin-bottom:6px;">${new Date(log.createdAt).toLocaleString()} by ${log.changedBy}</div>
                                <div style="font-size:0.95rem;">Old: PHP ${Number(log.oldPrice).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})} → New: PHP ${Number(log.newPrice).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
                            </div>
                        `)
                        .join('');
                })
                .catch(() => {
                    logContainer.innerHTML = '<p style="margin:0;color:#b91c1c;">Unable to load price history.</p>';
                });
        }

        function openPriceUpdateSelector() {
            const selector = document.getElementById('price-update-selector-modal');
            if (!selector) return;
            selector.style.display = 'flex';
        }

        function closePriceUpdateSelector() {
            const selector = document.getElementById('price-update-selector-modal');
            if (selector) selector.style.display = 'none';
        }

        function filterPriceUpdateSelectorRows() {
            const filter = (document.getElementById('price-update-filter').value || '').trim().toLowerCase();
            document.querySelectorAll('#price-update-selector-rows tr').forEach(row => {
                row.style.display = row.dataset.priceSelectorSearch.includes(filter) ? '' : 'none';
            });
        }

        function filterProductTiles() {
            const q = (document.getElementById('pos-product-search').value || '').trim().toLowerCase();
            document.querySelectorAll('.products-grid-container .product-tile').forEach(tile => {
                const text = (tile.dataset.search || '').toLowerCase();
                tile.style.display = text.includes(q) ? '' : 'none';
            });
        }

        async function savePriceUpdateFromSelector(productId, productName) {
            const input = document.getElementById(`selector-price-${productId}`);
            if (!input) return;
            const price = Number(input.value);
            if (!Number.isFinite(price) || price < 0) return alert('Enter a valid non-negative price.');

            try {
                const response = await fetch('/inventory/update-price', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId, price })
                });
                const result = await response.json();
                if (!result.success) return alert(result.message);
                location.reload();
            } catch (error) {
                alert('Unable to update the product price.');
            }
        }

        function closePriceUpdateModal() {
            const modal = document.getElementById('price-update-modal');
            if (modal) modal.style.display = 'none';
        }

        async function savePriceUpdate() {
            const modal = document.getElementById('price-update-modal');
            if (!modal) return;
            const productId = modal.dataset.productId;
            const newField = document.getElementById('price-update-new');
            const status = document.getElementById('price-update-status');
            const price = Number(newField.value);

            if (!Number.isFinite(price) || price < 0) {
                status.style.color = '#b91c1c';
                status.textContent = 'Enter a valid non-negative price.';
                return;
            }

            status.style.color = '#475569';
            status.textContent = 'Saving price update...';

            try {
                const response = await fetch('/inventory/update-price', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId, price })
                });
                const result = await response.json();
                if (!result.success) {
                    status.style.color = '#b91c1c';
                    status.textContent = result.message;
                    return;
                }
                status.style.color = '#047857';
                status.textContent = 'Price updated successfully.';
                setTimeout(() => location.reload(), 700);
            } catch (error) {
                status.style.color = '#b91c1c';
                status.textContent = 'Unable to update the price.';
            }
        }

        // Delivery modal functions
        function openDeliveryModal() {
            const modal = document.getElementById('delivery-modal');
            if (!modal) return;
            modal.style.display = 'flex';
            document.getElementById('delivery-receipt-no').value = '';
            const tbody = document.getElementById('delivery-lines');
            // reset to single empty row
            while (tbody.children.length > 1) tbody.removeChild(tbody.lastElementChild);
            const first = tbody.querySelector('tr');
            if (first) {
                first.querySelectorAll('input').forEach(i => i.value = '');
                const sel = first.querySelector('select');
                if (sel) sel.selectedIndex = 0;
            }
        }

        function closeDeliveryModal() {
            const modal = document.getElementById('delivery-modal');
            if (modal) modal.style.display = 'none';
        }

        function deliveryProductChanged(sel) {
            const id = sel.id || '';
            const idx = id.split('-').pop();
            const skuInput = document.getElementById(`delivery-sku-${idx}`);
            const stockInput = document.getElementById(`delivery-stock-${idx}`);
            const opt = sel.selectedOptions && sel.selectedOptions[0];
            if (opt) {
                if (skuInput) skuInput.value = opt.dataset.sku || '';
                if (stockInput) stockInput.value = opt.dataset.stock || '';
            }
        }

        function addDeliveryLine() {
            const tbody = document.getElementById('delivery-lines');
            const idx = tbody.children.length;
            const first = tbody.querySelector('tr');
            if (!first) return;
            const clone = first.cloneNode(true);
            // update ids
            clone.querySelectorAll('[id]').forEach(el => {
                el.id = el.id.replace(/-0$/, `-${idx}`);
            });
            // reset values
            clone.querySelectorAll('input').forEach(i => i.value = i.type === 'number' ? '0' : '');
            const sel = clone.querySelector('select');
            if (sel) {
                sel.dataset.lineIndex = idx;
                sel.id = `delivery-product-${idx}`;
                sel.selectedIndex = 0;
                sel.setAttribute('onchange', 'deliveryProductChanged(this)');
            }
            // attach remove handler stays same
            tbody.appendChild(clone);
        }

        function removeDeliveryLine(btn) {
            const row = btn.closest('tr');
            const tbody = document.getElementById('delivery-lines');
            if (!row || !tbody) return;
            if (tbody.children.length === 1) {
                // clear inputs
                row.querySelectorAll('input').forEach(i => i.value = i.type === 'number' ? '0' : '');
                const sel = row.querySelector('select'); if (sel) sel.selectedIndex = 0;
                return;
            }
            row.remove();
        }

        async function saveDelivery() {
            const status = document.getElementById('delivery-status');
            const receiptNo = (document.getElementById('delivery-receipt-no').value || '').trim();
            if (!receiptNo) {
                status.style.color = '#b91c1c'; status.textContent = 'Enter a delivery receipt number.'; return;
            }
            const tbody = document.getElementById('delivery-lines');
            const lines = [];
            tbody.querySelectorAll('tr').forEach((tr) => {
                const sel = tr.querySelector('select');
                const qtyInput = tr.querySelector('input[type="number"]');
                const skuInput = tr.querySelector('[id^="delivery-sku-"]');
                const sku = skuInput ? skuInput.value : '';
                const name = sel && sel.selectedOptions && sel.selectedOptions[0] ? sel.selectedOptions[0].dataset.name : '';
                const productId = sel ? sel.value : '';
                const qty = Number(qtyInput && qtyInput.value) || 0;
                if (!productId || qty <= 0) return;
                lines.push({ product: productId, sku, name, qty });
            });

            if (!lines.length) { status.style.color = '#b91c1c'; status.textContent = 'Add at least one line with qty > 0.'; return; }

            status.style.color = '#475569'; status.textContent = 'Receiving delivery...';
            try {
                const response = await fetch('/inventory/receive-delivery', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ receiptNo, lines }) });
                const result = await response.json();
                if (!result.success) { status.style.color = '#b91c1c'; status.textContent = result.message || 'Unable to receive delivery.'; return; }
                status.style.color = '#047857'; status.textContent = 'Delivery received. Preparing receipt...';

                // print simple receipt
                const createdBy = '<%= user %>' || 'system';
                const now = new Date();
                let html = `<html><head><title>Delivery ${receiptNo}</title><style>body{font-family:Arial;padding:20px}table{width:100%;border-collapse:collapse}th,td{padding:8px;border-bottom:1px solid #ddd;text-align:left}</style></head><body>`;
                html += `<h2>Delivery Receipt</h2><p>Receipt No: ${receiptNo}</p><p>Received By: ${createdBy}</p><p>Date: ${now.toLocaleString()}</p>`;
                html += `<table><thead><tr><th>Product</th><th>SKU</th><th>Qty</th></tr></thead><tbody>`;
                lines.forEach(l => { html += `<tr><td>${l.name}</td><td>${l.sku}</td><td>${l.qty}</td></tr>`; });
                html += `</tbody></table><p style="margin-top:20px;">-- End of Receipt --</p></body></html>`;

                const w = window.open('', '_blank');
                if (w) { w.document.write(html); w.document.close(); w.focus(); w.print(); }

                setTimeout(() => location.reload(), 900);
            } catch (err) {
                status.style.color = '#b91c1c'; status.textContent = 'Unable to receive delivery.';
            }
        }

        window.addEventListener('click', (event) => {
            const modal = document.getElementById('price-update-modal');
            if (modal && event.target === modal) {
                closePriceUpdateModal();
            }
        });

        function filterRegistryRows() {
            const search = (document.getElementById('registry-search').value || '').trim().toLowerCase();
            document.querySelectorAll('#registry-rows tr').forEach(row => {
                row.style.display = row.dataset.registrySearch.includes(search) ? '' : 'none';
            });
        }

        initializeEndOfDay();
    </script>
</body>
</html>
